# ── Required ──────────────────────────────────────────────────────────────
# Reown AppKit project id — create one at https://dashboard.reown.com
# (add your production domain to the project's allowlist)
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id

# Deployed RzSwap contract on BSC (from `forge script script/DeployRzSwap.s.sol`)
NEXT_PUBLIC_RZSWAP_ADDRESS=0x0000000000000000000000000000000000000000

# ── Optional ──────────────────────────────────────────────────────────────
# Public URL of the deployment (used for WalletConnect verification metadata).
# e.g. https://rzswap.vercel.app — falls back to the runtime origin if unset.
NEXT_PUBLIC_APP_URL=

# A source tag Relay attributes volume to (your app domain)
NEXT_PUBLIC_RELAY_SOURCE=rzswap.app

# NOTE: all NEXT_PUBLIC_* vars are inlined at BUILD time — set them in Vercel
# before building, and redeploy after changing any of them.
