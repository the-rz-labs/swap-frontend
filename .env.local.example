# ── Required ──────────────────────────────────────────────────────────────
# Reown AppKit project id — create one at https://dashboard.reown.com
# (add your production domain to the project's allowlist)
NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id

# Deployed contracts on BSC (from `forge script script/DeployTreasurySwap.s.sol`)
# RzSwap engine — read-only quoting (getOutputAmount). Execution goes through the gateway.
NEXT_PUBLIC_RZSWAP_ADDRESS=0x375B3955e58c0D77ea5F5436ED8413c189DB5B52
# RzGateway — the SINGLE entrypoint the frontend uses for local/buy/sell.
NEXT_PUBLIC_RZ_GATEWAY=0x0000000000000000000000000000000000000000
# Relay deposit adapter used by the sell flow.
NEXT_PUBLIC_RELAY_DEPOSIT_ADAPTER=0x0000000000000000000000000000000000000000
# Relay RelayRouterV3 on BSC (executes the buy destination call). Default is the canonical address.
NEXT_PUBLIC_RELAY_ROUTER=0xb92fe925DC43a0ECdE6c8b1a2709c170Ec4fFf4f

# Deployed contracts on Ethereum (GOLDGR hub — from DeployEthereumFullStack)
NEXT_PUBLIC_ETH_RZSWAP_ADDRESS=0xB13Dcac1AEd9ebf08206cA1B64F4f678609E7622
NEXT_PUBLIC_ETH_RZ_GATEWAY=0xd2471055174319f30A441c856e6E5577f4a852B0
NEXT_PUBLIC_ETH_RELAY_DEPOSIT_ADAPTER=0xF1870A68dB291ed8B2c90605505893D0545c26aD
# ETH buy fill proxy — cleanupErc20s → fill → gateway (required for USDT→GOLDGR; mainnet USDT-safe)
NEXT_PUBLIC_ETH_USDT_FILL_ADAPTER=0x4E221f8270737aA478F7967FE04Bb1707f30E993
# Relay depository on Ethereum (confirm via /quote; currently same address as BSC)
NEXT_PUBLIC_ETH_RELAY_DEPOSITORY=0x4cD00E387622C35bDDB9b4c962C136462338BC31

# ── Optional ──────────────────────────────────────────────────────────────
# Public URL of the deployment (used for WalletConnect verification metadata).
# e.g. https://rzswap.vercel.app — falls back to the runtime origin if unset.
NEXT_PUBLIC_APP_URL=

# A source tag Relay attributes volume to (your app domain)
NEXT_PUBLIC_RELAY_SOURCE=rzswap.app

# On-chain read RPCs (balances/quotes). Defaults are public endpoints; override for reliability.
NEXT_PUBLIC_BSC_RPC=https://bsc-dataseed.bnbchain.org
# Prefer a free public ETH RPC. If MetaMask still fails approve with "Unauthorized" /
# "JSON-RPC protocol is not supported", set Ethereum Mainnet's RPC in MetaMask to this URL
# (MetaMask ignores dapp RPCs for the built-in Ethereum network when a custom/gated one is set).
NEXT_PUBLIC_ETH_RPC=https://ethereum.publicnode.com

# NOTE: all NEXT_PUBLIC_* vars are inlined at BUILD time — set them in Vercel
# before building, and redeploy after changing any of them.
